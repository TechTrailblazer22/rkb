// RKB Platform data model.
// Phase 0: User. Phase 1: consent, Builder, BuilderMember.
// Phase 3: full builder profile, verification documents, audit log.
// Phase 4: projects, approvals, media, plots and the plot status log.
// Phase 5: shortlist (saved projects).
// Later phases add Project, Plot, Lead...
// Connection URLs are configured in prisma7.config.ts (migrations) and src/lib/db.ts (runtime).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  BUILDER_OWNER
  BUILDER_TEAM
  ADMIN
}

enum BuilderStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BuilderMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum BuilderType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  OTHER
}

// Plan the builder is interested in. Prices and limits live in code until Phase 7.
enum PlanCode {
  STARTER
  GROWTH
  PREMIER
}

enum DocumentKind {
  PAN
  GST
  BUSINESS_PROOF
  IDENTITY_PROOF
  ADDRESS_PROOF
  RERA
  BANK_PROOF
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Identity comes from Auth0 (auth0Sub). Role and builder membership are ours.
model User {
  id              String    @id @default(cuid())
  auth0Sub        String    @unique
  email           String    @unique
  name            String?
  mobile          String?
  role            Role      @default(BUYER)
  // DPDP consent: which version of the terms/privacy notice the user accepted, and when.
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  builderMemberships BuilderMember[]
  uploadedDocuments  BuilderDocument[]
  shortlist          Shortlist[]
  reviews            Review[]
  bookings           Booking[]
  leads              Lead[]
  leadNotes          LeadNote[]
  activity           UserActivity[]

  @@index([role])
}

// A builder / developer company.
model Builder {
  id     String        @id @default(cuid())
  status BuilderStatus @default(DRAFT)
  // Set when the builder is verified; used by the public profile page (Phase 5).
  slug   String?       @unique

  // Company
  companyName       String?
  type              BuilderType?
  yearEstablished   Int?
  projectsCompleted Int?
  projectsOngoing   Int?
  about             String?
  website           String?

  // Contact
  contactPerson String?
  contactMobile String?
  whatsapp      String?

  // Office
  addressLine   String?
  city          String?
  state         String?
  pincode       String?
  serviceCities String[] @default([])

  // Branding. Keys into file storage; the files are public.
  logoKey  String?
  coverKey String?

  // Identity and registration numbers
  pan           String?
  gstin         String?
  reraNumber    String?
  reraValidTill DateTime?

  interestedPlan  PlanCode?
  // The linked account that receives token payments (Razorpay Route). Set by staff; without it, online
  // booking is not offered for this company, because the money would otherwise sit with us.
  payoutAccountId String?

  // Verification workflow
  submittedAt  DateTime?
  reviewedAt   DateTime?
  verifiedAt   DateTime?
  // When the last daily summary of new enquiries was emailed.
  lastDigestAt DateTime?
  // Latest message from the reviewer, shown to the builder.
  reviewNote   String?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       BuilderMember[]
  leads         Lead[]
  subscription  Subscription?
  bookings      Booking[]
  reviews       Review[]
  reports       PerformanceReport[]
  paymentOrders PaymentOrder[]
  invoices      Invoice[]
  teamInvites   TeamInvite[]
  featuredDays  FeaturedDay[]
  documents     BuilderDocument[]
  projects      Project[]

  @@index([status])
  @@index([pan])
  @@index([gstin])
}

model BuilderMember {
  id        String            @id @default(cuid())
  builderId String
  userId    String
  role      BuilderMemberRole
  createdAt DateTime          @default(now())

  builder Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([builderId, userId])
  @@index([userId])
}

// One current file per kind per builder. Uploading again replaces it.
// Files are private: only the builder's members and admins can open them.
model BuilderDocument {
  id           String         @id @default(cuid())
  builderId    String
  kind         DocumentKind
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  status       DocumentStatus @default(PENDING)
  // Reviewer's note when a document is rejected.
  reviewNote   String?
  uploadedById String
  createdAt    DateTime       @default(now())
  reviewedAt   DateTime?

  builder    Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@unique([builderId, kind])
  @@index([status])
}

// Who did what, and when. Never edited, only appended.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------------------
// Phase 4: projects and plot inventory
// ---------------------------------------------------------------------------------------

enum ProjectType {
  PLOTTED
  FARM_HOUSE
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
}

enum ProjectStage {
  PRE_LAUNCH
  UNDER_CONSTRUCTION
  READY_TO_MOVE
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  LIVE
  PAUSED
  ARCHIVED
}

enum ApprovalKind {
  RERA
  TNCP
  MUNICIPAL
  BANK_LOAN
  OTHER
}

enum MediaKind {
  PHOTO
  LAYOUT
  BROCHURE
}

// HELD is reserved for online booking (a plot reserved while a token payment completes).
enum PlotStatus {
  AVAILABLE
  HELD
  BOOKED
  SOLD
}

enum PlotFacing {
  NORTH
  SOUTH
  EAST
  WEST
  NORTH_EAST
  NORTH_WEST
  SOUTH_EAST
  SOUTH_WEST
}

// One project listing. Every field except name, type and stage is optional so the builder can
// save a draft at any point; the checklist in code decides what is needed to submit.
model Project {
  id        String        @id @default(cuid())
  builderId String
  // Set when the project first goes live; used by the public page (Phase 5).
  slug      String?       @unique
  status    ProjectStatus @default(DRAFT)

  // Basics
  name        String
  type        ProjectType
  stage       ProjectStage @default(PRE_LAUNCH)
  city        String?
  locality    String?
  addressLine String?
  mapUrl      String?
  description String?

  // Size and layout
  acres           Float?
  totalPlots      Int?
  openAreaPercent Int?
  phasesCount     Int?

  // Legal
  landUse     String?
  titleStatus String?
  bankLoans   String[] @default([])

  // Timeline
  startDate       DateTime?
  completionDate  DateTime?
  percentComplete Int?

  // Pricing, in rupees
  pricePerSqft      Int?
  budgetFrom        Int?
  budgetTo          Int?
  tokenAmount       Int?
  paymentPlan       String?
  additionalCharges String?
  offers            String?

  amenities String[] @default([])
  videoUrl  String?
  // A link to a 360-degree tour, shown as a button. Premier plan.
  tourUrl   String?

  // Contact
  contactName       String?
  contactMobile     String?
  whatsapp          String?
  visitingHours     String?
  hideContactNumber Boolean @default(false)

  // Review workflow
  submittedAt  DateTime?
  publishedAt  DateTime?
  reviewedAt   DateTime?
  reviewNote   String?
  // Why a paused project is paused: PLAN_LAPSED resumes by itself when the plan returns;
  // ADMIN and APPROVAL_EXPIRED do not.
  pauseReason  String?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  builder           Builder            @relation(fields: [builderId], references: [id], onDelete: Cascade)
  approvals         ProjectApproval[]
  media             ProjectMedia[]
  plots             Plot[]
  shortlisted       Shortlist[]
  leads             Lead[]
  featuredDays      FeaturedDay[]
  projectDailyStats ProjectDailyStat[]
  layoutShapes      LayoutShape[]
  progressUpdates   ProgressUpdate[]
  bookings          Booking[]

  @@index([builderId, status])
  @@index([status])
  // Search and the city and type pages filter live projects by these.
  @@index([status, type])
  @@index([status, city])
}

// RERA, TNCP, municipal and bank-loan approvals. At most one of each kind per project.
// The optional document is private, like builder verification documents.
model ProjectApproval {
  id           String       @id @default(cuid())
  projectId    String
  kind         ApprovalKind
  number       String?
  validFrom    DateTime?
  validTill    DateTime?
  storageKey   String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  // Set by an admin after checking the number and document.
  verified     Boolean      @default(false)
  verifiedAt   DateTime?
  reviewNote   String?
  // The smallest "days left" warning already emailed (30, 7 or 1), so a daily job never repeats one.
  warnedDays   Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind])
}

// Photos, the layout plan and the brochure. These are shown to buyers, so the files are public.
model ProjectMedia {
  id           String    @id @default(cuid())
  projectId    String
  kind         MediaKind
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  tag          String?
  isCover      Boolean   @default(false)
  uploadedById String
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind])
}

model Plot {
  id          String      @id @default(cuid())
  projectId   String
  // What the builder calls it, for example "A-12".
  number      String
  // number with digit runs zero-padded, so "A-2" sorts before "A-10".
  sortKey     String
  sizeSqft    Int
  dimensions  String?
  facing      PlotFacing?
  isCorner    Boolean     @default(false)
  roadWidthFt Int?
  ratePerSqft Int?
  price       Int?
  status      PlotStatus  @default(AVAILABLE)
  phase       String?
  // For built projects: "2 BHK", "Shop", ...
  unitType    String?
  builtUpSqft Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shape    LayoutShape?
  bookings Booking[]

  @@unique([projectId, number])
  @@index([projectId, sortKey])
  @@index([projectId, status])
}

// Every status change of a plot, kept even if the plot is later deleted. Settles disputes
// such as "who marked this plot sold, and when".
model PlotStatusLog {
  id         String      @id @default(cuid())
  plotId     String
  plotNumber String
  projectId  String
  fromStatus PlotStatus?
  toStatus   PlotStatus
  actorId    String?
  // "manual", "bulk", "import" or "series".
  via        String
  createdAt  DateTime    @default(now())

  @@index([plotId])
  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------------------
// Phase 5: the public marketplace
// ---------------------------------------------------------------------------------------

// A project a logged-in user has saved. One row per user and project.
model Shortlist {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------------------
// Enquiries (Phase 6). See docs/LEADS.md.

enum LeadStatus {
  NEW
  CONTACTED
  SITE_VISIT
  NEGOTIATION
  BOOKED
  LOST
}

enum VisitStatus {
  REQUESTED
  CONFIRMED
  DONE
  CANCELLED
}

enum NoteKind {
  BUILDER
  BUYER
  SYSTEM
}

// A buyer's enquiry about one project. The company is stored on the lead as well as the project, so
// every builder query can be scoped by it directly.
model Lead {
  id        String @id @default(cuid())
  projectId String
  builderId String
  buyerId   String

  // What the buyer typed. The mobile is not verified until an SMS provider exists.
  name           String
  mobile         String
  email          String
  message        String?
  preferredPlot  String?
  mobileVerified Boolean @default(false)
  source         String  @default("project_page")

  status LeadStatus @default(NEW)

  // Consent to share these details with the builder: when, and under which version of the terms.
  consentAt           DateTime
  consentTermsVersion String

  followUpAt         DateTime?
  // Set when a reminder for the current followUpAt has been emailed; cleared when the date changes.
  reminderSentAt     DateTime?
  // The latest message from the buyer, so a repeat enquiry floats the lead up the inbox.
  lastBuyerMessageAt DateTime  @default(now())
  // Whether the builder has opened the lead since the last buyer message.
  seenAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  builder Builder     @relation(fields: [builderId], references: [id], onDelete: Cascade)
  buyer   User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  notes   LeadNote[]
  visits  SiteVisit[]

  @@index([builderId, status, lastBuyerMessageAt])
  @@index([buyerId, createdAt])
  @@index([projectId])
  @@index([followUpAt])
}

// The lead's timeline: what the buyer wrote, what the builder noted, and what the system did.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  kind      NoteKind
  text      String
  createdAt DateTime @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model SiteVisit {
  id          String      @id @default(cuid())
  leadId      String
  scheduledAt DateTime
  status      VisitStatus @default(REQUESTED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ---------------------------------------------------------------------------------------
// Plans, subscriptions and invoices (Phases 7 and 8). See docs/ROADMAP-7-10.md.

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

enum SubscriptionSource {
  MANUAL
  GATEWAY
  COMP
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

// What a company is on right now. One row per company; the plan, the paid period and what happens
// next. Everything the company may do is derived from this (see lib/entitlements.ts).
model Subscription {
  id                 String             @id @default(cuid())
  builderId          String             @unique
  plan               PlanCode
  interval           BillingInterval    @default(MONTHLY)
  status             SubscriptionStatus @default(ACTIVE)
  source             SubscriptionSource
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  // A downgrade the company asked for, applied at the next renewal.
  pendingPlan        PlanCode?
  pendingInterval    BillingInterval?
  // The company will not renew; it keeps the plan to the end of the period.
  cancelAtPeriodEnd  Boolean            @default(false)
  // The smallest "days left" reminder already emailed (7, 3 or 1).
  lastReminderDays   Int?
  // What was paid for the current period, before GST. An upgrade credits the unused share of this.
  paidSubtotalPaise  Int                @default(0)
  note               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  builder  Builder   @relation(fields: [builderId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([status, currentPeriodEnd])
}

enum InvoiceStatus {
  PAID
  VOID
  REFUNDED
}

// A tax invoice. Amounts are in paise (integers). The bill-to details are copied here, so editing
// the company profile later never rewrites an invoice that was already issued.
model Invoice {
  id               String          @id @default(cuid())
  number           String          @unique
  builderId        String
  subscriptionId   String?
  description      String
  plan             PlanCode
  interval         BillingInterval
  periodStart      DateTime
  periodEnd        DateTime
  subtotalPaise    Int
  cgstPaise        Int             @default(0)
  sgstPaise        Int             @default(0)
  igstPaise        Int             @default(0)
  totalPaise       Int
  status           InvoiceStatus   @default(PAID)
  // How it was paid: "razorpay", "test", "manual" (with a reference) or "comp" (nothing was paid).
  paymentMethod    String
  paymentReference String?
  billTo           Json
  // Who issued it (name, GSTIN, state, address), copied from the configuration at the time.
  supplier         Json?
  sac              String
  issuedAt         DateTime        @default(now())
  paidAt           DateTime?
  refundedAt       DateTime?
  refundNote       String?
  createdAt        DateTime        @default(now())

  builder      Builder       @relation(fields: [builderId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([builderId, issuedAt])
}

enum PaymentPurpose {
  SUBSCRIPTION
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
}

enum PlanChange {
  SUBSCRIBE
  RENEW
  UPGRADE
}

// A payment we asked a company to make. Our database decides what it buys; the gateway only
// collects the money. `providerOrderId` is the gateway's id for it.
model PaymentOrder {
  id                String          @id @default(cuid())
  builderId         String
  purpose           PaymentPurpose  @default(SUBSCRIPTION)
  change            PlanChange
  plan              PlanCode
  interval          BillingInterval
  // The new period's list price, the credit for the unused part of the old one, and what is taxed.
  listPaise         Int
  creditPaise       Int             @default(0)
  subtotalPaise     Int
  // What the company pays, GST included. The gateway must report exactly this.
  totalPaise        Int
  status            PaymentStatus   @default(CREATED)
  provider          String
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  createdById       String
  paidAt            DateTime?
  invoiceId         String?
  failureReason     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  builder Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)

  @@index([builderId, createdAt])
  @@index([status, createdAt])
}

// Each gateway notification we have handled, by the gateway's own id, so one that arrives twice
// (they retry) is recognised. Only ids and the type are kept: no card or contact details.
model PaymentEvent {
  id              String   @id @default(cuid())
  provider        String
  eventId         String
  type            String
  providerOrderId String?
  createdAt       DateTime @default(now())

  @@unique([provider, eventId])
}

// One counter per financial year, so invoice numbers run 0001, 0002, ... with no gaps.
model InvoiceCounter {
  fy   String @id
  last Int    @default(0)
}

model TeamInvite {
  id          String            @id @default(cuid())
  builderId   String
  email       String
  role        BuilderMemberRole
  // Only a hash of the link's token is stored, so a database leak cannot be used to join a company.
  tokenHash   String            @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime          @default(now())

  builder Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)

  @@index([builderId])
  @@index([email])
}

// A day on which a company has asked for a project to be featured in search.
model FeaturedDay {
  projectId String
  builderId String
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  builder Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)

  @@id([projectId, day])
  @@index([builderId, day])
  @@index([day])
}

// ---------------------------------------------------------------------------------------
// Phase 9: analytics, reviews, the layout map and construction progress.

enum StatEvent {
  VIEW
  CALL
  WHATSAPP
  SHORTLIST
  ENQUIRY
  VISIT
}

// Counters, not raw events: one row per project, day, event and traffic source, bumped by an atomic
// upsert, so the free database stays small and no personal data is stored.
model ProjectDailyStat {
  projectId String
  day       DateTime  @db.Date
  event     StatEvent
  source    String    @default("direct")
  count     Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, day, event, source])
  @@index([day])
}

// The monthly performance email, so that a company gets it once per month however often the job runs.
model PerformanceReport {
  builderId String
  month     String
  sentAt    DateTime @default(now())

  builder Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)

  @@id([builderId, month])
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

// A buyer's review of a company. Only someone who sent that company an enquiry can write one, once.
// It is held for staff to publish or reject; the company may reply once (editable).
model Review {
  id            String       @id @default(cuid())
  builderId     String
  buyerId       String
  // How the reviewer is shown ("Asha K."), kept here so it survives the buyer account being removed.
  displayName   String
  rating        Int
  body          String
  status        ReviewStatus @default(PENDING)
  rejectReason  String?
  reply         String?
  repliedAt     DateTime?
  repliedById   String?
  moderatedById String?
  moderatedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  builder Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([builderId, buyerId])
  @@index([builderId, status, createdAt])
  @@index([status, createdAt])
}

// A rectangle on the layout map, as percentages of the map's width and height, for one plot.
model LayoutShape {
  id        String   @id @default(cuid())
  projectId String
  plotId    String   @unique
  x         Float
  y         Float
  w         Float
  h         Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plot    Plot    @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// A dated note (with an optional photo) on how the construction is going, shown on the project page.
model ProgressUpdate {
  id            String   @id @default(cuid())
  projectId     String
  note          String
  photoKey      String?
  createdById   String
  // How many people were emailed about it.
  notifiedCount Int      @default(0)
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------------------
// Phase 10: online token booking. See docs/BOOKING.md.

enum BookingStatus {
  // The plot is held for the buyer while the token is paid.
  HELD
  PAID
  // The hold ran out unpaid.
  EXPIRED
  CANCELLED
  // Money arrived that cannot be kept (after the hold ended, or the plot went elsewhere): staff or
  // the company must refund it.
  REFUND_DUE
  REFUNDED
}

model Booking {
  id                String        @id @default(cuid())
  plotId            String?
  // Kept so the record still reads correctly if the plot is later deleted.
  plotNumber        String
  projectId         String
  builderId         String
  buyerId           String
  buyerName         String
  buyerMobile       String
  tokenPaise        Int
  status            BookingStatus @default(HELD)
  holdExpiresAt     DateTime
  provider          String
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  paidAt            DateTime?
  refundedAt        DateTime?
  refundId          String?
  note              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  plot    Plot?   @relation(fields: [plotId], references: [id], onDelete: SetNull)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  builder Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([plotId, status])
  @@index([status, holdExpiresAt])
  @@index([builderId, createdAt])
  @@index([buyerId, createdAt])
}

// Which logged-in people used the site, and through which account, on which day. One row per person,
// day and account (buyer, builder or admin), written the first time that person is seen that day, so
// the table grows by at most one row per person per day. No page, address or device is recorded.
model UserActivity {
  userId String
  day    DateTime @db.Date
  mode   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, mode])
  @@index([day, mode])
}
