// RKB Platform data model.
// Phase 0: User. Phase 1: consent, Builder, BuilderMember.
// Phase 3: full builder profile, verification documents, audit log.
// Phase 4: projects, approvals, media, plots and the plot status log.
// Phase 5: shortlist (saved projects).
// Later phases add Project, Plot, Lead...
// Connection URLs are configured in prisma7.config.ts (migrations) and src/lib/db.ts (runtime).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  BUILDER_OWNER
  BUILDER_TEAM
  ADMIN
}

enum BuilderStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BuilderMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum BuilderType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  OTHER
}

// Plan the builder is interested in. Prices and limits live in code until Phase 7.
enum PlanCode {
  STARTER
  GROWTH
  PREMIER
}

enum DocumentKind {
  PAN
  GST
  BUSINESS_PROOF
  IDENTITY_PROOF
  ADDRESS_PROOF
  RERA
  BANK_PROOF
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Identity comes from Auth0 (auth0Sub). Role and builder membership are ours.
model User {
  id              String    @id @default(cuid())
  auth0Sub        String    @unique
  email           String    @unique
  name            String?
  mobile          String?
  role            Role      @default(BUYER)
  // DPDP consent: which version of the terms/privacy notice the user accepted, and when.
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  builderMemberships BuilderMember[]
  uploadedDocuments  BuilderDocument[]
  shortlist          Shortlist[]

  @@index([role])
}

// A builder / developer company.
model Builder {
  id     String        @id @default(cuid())
  status BuilderStatus @default(DRAFT)
  // Set when the builder is verified; used by the public profile page (Phase 5).
  slug   String?       @unique

  // Company
  companyName       String?
  type              BuilderType?
  yearEstablished   Int?
  projectsCompleted Int?
  projectsOngoing   Int?
  about             String?
  website           String?

  // Contact
  contactPerson String?
  contactMobile String?
  whatsapp      String?

  // Office
  addressLine   String?
  city          String?
  state         String?
  pincode       String?
  serviceCities String[] @default([])

  // Branding. Keys into file storage; the files are public.
  logoKey  String?
  coverKey String?

  // Identity and registration numbers
  pan           String?
  gstin         String?
  reraNumber    String?
  reraValidTill DateTime?

  interestedPlan PlanCode?

  // Verification workflow
  submittedAt  DateTime?
  reviewedAt   DateTime?
  verifiedAt   DateTime?
  // Latest message from the reviewer, shown to the builder.
  reviewNote   String?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   BuilderMember[]
  documents BuilderDocument[]
  projects  Project[]

  @@index([status])
  @@index([pan])
  @@index([gstin])
}

model BuilderMember {
  id        String            @id @default(cuid())
  builderId String
  userId    String
  role      BuilderMemberRole
  createdAt DateTime          @default(now())

  builder Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([builderId, userId])
  @@index([userId])
}

// One current file per kind per builder. Uploading again replaces it.
// Files are private: only the builder's members and admins can open them.
model BuilderDocument {
  id           String         @id @default(cuid())
  builderId    String
  kind         DocumentKind
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  status       DocumentStatus @default(PENDING)
  // Reviewer's note when a document is rejected.
  reviewNote   String?
  uploadedById String
  createdAt    DateTime       @default(now())
  reviewedAt   DateTime?

  builder    Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@unique([builderId, kind])
  @@index([status])
}

// Who did what, and when. Never edited, only appended.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------------------
// Phase 4: projects and plot inventory
// ---------------------------------------------------------------------------------------

enum ProjectType {
  PLOTTED
  FARM_HOUSE
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
}

enum ProjectStage {
  PRE_LAUNCH
  UNDER_CONSTRUCTION
  READY_TO_MOVE
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  LIVE
  PAUSED
  ARCHIVED
}

enum ApprovalKind {
  RERA
  TNCP
  MUNICIPAL
  BANK_LOAN
  OTHER
}

enum MediaKind {
  PHOTO
  LAYOUT
  BROCHURE
}

// HELD is reserved for online booking (a plot reserved while a token payment completes).
enum PlotStatus {
  AVAILABLE
  HELD
  BOOKED
  SOLD
}

enum PlotFacing {
  NORTH
  SOUTH
  EAST
  WEST
  NORTH_EAST
  NORTH_WEST
  SOUTH_EAST
  SOUTH_WEST
}

// One project listing. Every field except name, type and stage is optional so the builder can
// save a draft at any point; the checklist in code decides what is needed to submit.
model Project {
  id        String        @id @default(cuid())
  builderId String
  // Set when the project first goes live; used by the public page (Phase 5).
  slug      String?       @unique
  status    ProjectStatus @default(DRAFT)

  // Basics
  name        String
  type        ProjectType
  stage       ProjectStage @default(PRE_LAUNCH)
  city        String?
  locality    String?
  addressLine String?
  mapUrl      String?
  description String?

  // Size and layout
  acres           Float?
  totalPlots      Int?
  openAreaPercent Int?
  phasesCount     Int?

  // Legal
  landUse     String?
  titleStatus String?
  bankLoans   String[] @default([])

  // Timeline
  startDate       DateTime?
  completionDate  DateTime?
  percentComplete Int?

  // Pricing, in rupees
  pricePerSqft      Int?
  budgetFrom        Int?
  budgetTo          Int?
  tokenAmount       Int?
  paymentPlan       String?
  additionalCharges String?
  offers            String?

  amenities String[] @default([])
  videoUrl  String?

  // Contact
  contactName       String?
  contactMobile     String?
  whatsapp          String?
  visitingHours     String?
  hideContactNumber Boolean @default(false)

  // Review workflow
  submittedAt  DateTime?
  publishedAt  DateTime?
  reviewedAt   DateTime?
  reviewNote   String?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  builder     Builder           @relation(fields: [builderId], references: [id], onDelete: Cascade)
  approvals   ProjectApproval[]
  media       ProjectMedia[]
  plots       Plot[]
  shortlisted Shortlist[]

  @@index([builderId, status])
  @@index([status])
  // Search and the city and type pages filter live projects by these.
  @@index([status, type])
  @@index([status, city])
}

// RERA, TNCP, municipal and bank-loan approvals. At most one of each kind per project.
// The optional document is private, like builder verification documents.
model ProjectApproval {
  id           String       @id @default(cuid())
  projectId    String
  kind         ApprovalKind
  number       String?
  validFrom    DateTime?
  validTill    DateTime?
  storageKey   String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  // Set by an admin after checking the number and document.
  verified     Boolean      @default(false)
  verifiedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind])
}

// Photos, the layout plan and the brochure. These are shown to buyers, so the files are public.
model ProjectMedia {
  id           String    @id @default(cuid())
  projectId    String
  kind         MediaKind
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  tag          String?
  isCover      Boolean   @default(false)
  uploadedById String
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind])
}

model Plot {
  id          String      @id @default(cuid())
  projectId   String
  // What the builder calls it, for example "A-12".
  number      String
  // number with digit runs zero-padded, so "A-2" sorts before "A-10".
  sortKey     String
  sizeSqft    Int
  dimensions  String?
  facing      PlotFacing?
  isCorner    Boolean     @default(false)
  roadWidthFt Int?
  ratePerSqft Int?
  price       Int?
  status      PlotStatus  @default(AVAILABLE)
  phase       String?
  // For built projects: "2 BHK", "Shop", ...
  unitType    String?
  builtUpSqft Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId, sortKey])
  @@index([projectId, status])
}

// Every status change of a plot, kept even if the plot is later deleted. Settles disputes
// such as "who marked this plot sold, and when".
model PlotStatusLog {
  id         String      @id @default(cuid())
  plotId     String
  plotNumber String
  projectId  String
  fromStatus PlotStatus?
  toStatus   PlotStatus
  actorId    String?
  // "manual", "bulk", "import" or "series".
  via        String
  createdAt  DateTime    @default(now())

  @@index([plotId])
  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------------------
// Phase 5: the public marketplace
// ---------------------------------------------------------------------------------------

// A project a logged-in user has saved. One row per user and project.
model Shortlist {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}
