# Copy to .env for local development. Never commit real values.
# On Render, set these in the service's Environment tab (see render.yaml).

# Neon Postgres. Runtime uses the POOLED string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Neon DIRECT string (no "-pooler"). Used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth0 (Applications > your Regular Web Application > Settings)
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
# Encrypts the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=""
# Local development URL. On Render this is optional: RENDER_EXTERNAL_URL is used if unset.
APP_BASE_URL="http://localhost:3000"

# Comma separated emails that become ADMIN on login (email must be verified at Auth0)
ADMIN_EMAILS="you@example.com"

# --- File storage (builder documents, logos) ---
# Production: a Cloudinary account's "API environment variable" (Dashboard > Settings > API Keys).
# Looks like cloudinary://API_KEY:API_SECRET@CLOUD_NAME . Treat it as a secret.
# Leave unset in development: files then go to .data/storage on your own disk.
CLOUDINARY_URL=""
# STORAGE_DRIVER=local   # force local disk (development and tests only; never on Render)

# --- Email (verification updates to builders and admins) ---
# Production: a Resend API key. Leave unset in development: emails are written to .data/mail-outbox.jsonl.
RESEND_API_KEY=""
# Sender. Resend's sandbox sender only delivers to your own Resend login email, so
# verify a domain at Resend and set e.g. "RKB Platform <noreply@yourdomain.com>" before launch.
MAIL_FROM=""
